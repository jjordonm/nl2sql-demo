# Azure OpenAI endpoint URL (required)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI deployment name (required)
# AZURE_OPENAI_DEPLOYMENT=your-chat-deployment-name

# Azure OpenAI API version (optional)
# AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI API key (optional — fallback if Entra ID is unavailable)
# AZURE_OPENAI_API_KEY=your-api-key

# Authentication is via AAD/Entra ID (DefaultAzureCredential).
# For local dev, run: az login

# --- Teams Bot (required for function_app) ---
# MICROSOFT_APP_ID=your-bot-registration-app-id
# MICROSOFT_APP_PASSWORD=your-bot-registration-client-secret
# MICROSOFT_APP_TENANT_ID=your-azure-ad-tenant-id
